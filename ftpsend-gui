#!/bin/bash
# Wrapper to run ftpsend in a terminal with optional IP prompt

CONFIG_FILE="$HOME/.ftpsend_config.json"
DEFAULT_HOST="192.168.0.103"
DEFAULT_PORT="9999"

# Load last successful connection
if [ -f "$CONFIG_FILE" ]; then
    CURRENT_HOST=$(grep -oP '"host":\s*"\K[^"]+' "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_HOST")
    CURRENT_PORT=$(grep -oP '"port":\s*\K[0-9]+' "$CONFIG_FILE" 2>/dev/null || echo "$DEFAULT_PORT")
else
    CURRENT_HOST="$DEFAULT_HOST"
    CURRENT_PORT="$DEFAULT_PORT"
fi

# Create a temp script that will run inside konsole
TEMP_SCRIPT=$(mktemp)

# Write the script content
cat > "$TEMP_SCRIPT" <<EOFSCRIPT
#!/bin/bash

CONFIG_FILE="\$HOME/.ftpsend_config.json"
CURRENT_HOST="$CURRENT_HOST"
CURRENT_PORT="$CURRENT_PORT"

# Colors
RESET="\033[0m"
BOLD="\033[1m"
DIM="\033[2m"

# Vibrant colors
CYAN="\033[96m"
GREEN="\033[92m"
YELLOW="\033[93m"
MAGENTA="\033[95m"
PURPLE="\033[38;5;141m"
ORANGE="\033[38;5;208m"
WHITE="\033[97m"
GRAY="\033[90m"

clear
echo ""
echo ""
echo ""
echo -e "    \${BOLD}\${PURPLE}╔════════════════════════════════════════════════════════╗\${RESET}"
echo -e "    \${BOLD}\${PURPLE}║\${RESET}                                                        \${BOLD}\${PURPLE}║\${RESET}"
echo -e "    \${BOLD}\${PURPLE}║\${RESET}            \${BOLD}\${WHITE}S E R V E R   C O N F I G\${RESET}                \${BOLD}\${PURPLE}║\${RESET}"
echo -e "    \${BOLD}\${PURPLE}║\${RESET}                                                        \${BOLD}\${PURPLE}║\${RESET}"
echo -e "    \${BOLD}\${PURPLE}╚════════════════════════════════════════════════════════╝\${RESET}"
echo ""
echo ""
echo -e "        \${DIM}Current: \${CYAN}\$CURRENT_HOST\${RESET}:\${YELLOW}\$CURRENT_PORT\${RESET}"
echo ""
echo ""
echo ""

# Server IP with proper spacing
echo -n "        "
echo -n \$'\033[1m\033[96m'"Server IP:"
echo -n \$'\033[0m'"  "
read -e -i "\$CURRENT_HOST" NEW_HOST
NEW_HOST="\${NEW_HOST:-\$CURRENT_HOST}"

echo ""
echo ""

# Port with proper spacing
echo -n "        "
echo -n \$'\033[1m\033[96m'"Port:      "
echo -n \$'\033[0m'"  "
read -e -i "\$CURRENT_PORT" NEW_PORT
NEW_PORT="\${NEW_PORT:-\$CURRENT_PORT}"

# Update config file
echo "{\"host\":\"\$NEW_HOST\",\"port\":\$NEW_PORT}" > "\$CONFIG_FILE"

echo ""
echo ""
echo -e "        \${BOLD}\${GREEN}✓\${RESET} Configuration saved!"
echo -e "        \${GRAY}Server set to:\${RESET} \${CYAN}\$NEW_HOST\${RESET}:\${YELLOW}\$NEW_PORT\${RESET}"
echo ""
sleep 1

# Run ftpsend with all the file arguments passed to this script
exec /home/syed/bin/ftpsend "\$@"
EOFSCRIPT

chmod +x "$TEMP_SCRIPT"

# Run in konsole, passing all arguments properly
konsole -e "$TEMP_SCRIPT" "$@"

# Clean up temp script after konsole closes
rm -f "$TEMP_SCRIPT"
